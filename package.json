{
  "name": "rxjs-friendly",
  "version": "0.1.0",
  "description": "User-friendly RxJS operator vocabulary: keep the root, fix the suffix. Curried roots + boundary combinators dispatching to the official operators.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hansschenker/rxjs-operator-renaming.git"
  },
  "license": "MIT",
  "peerDependencies": {
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "rxjs": "^7.8.1",
    "tsup": "^8.2.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
